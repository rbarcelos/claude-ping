{
  "name": "claude-ping",
  "version": "0.2.0",
  "description": "WhatsApp MCP server for Claude Code - message yourself via WhatsApp",
  "type": "module",
  "main": "dist/mcp/server.js",
  "bin": {
    "claude-ping": "./dist/mcp/server.js",
    "claude-whatsapp": "./dist/index.js",
    "claude-ping-setup": "./dist/hooks/setup.js",
    "claude-ping-hook": "./dist/hooks/permission-hook.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/mcp/server.js",
    "start:standalone": "node dist/index.js",
    "dev": "tsx src/mcp/server.ts",
    "setup-hooks": "node dist/hooks/setup.js",
    "remove-hooks": "node dist/hooks/setup.js remove",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "claude",
    "whatsapp",
    "mcp",
    "ai",
    "bridge"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.2",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.0.15",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.15"
  }
}
